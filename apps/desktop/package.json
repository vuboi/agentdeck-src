{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-claude-agent.mjs && node scripts/build-codegraph.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm run test:voice",
    "test:account-switch": "node --experimental-strip-types --experimental-vm-modules --test src/lib/agents/credential-switch.test.ts src/lib/agents/account-rotation.test.mjs",
    "test:voice": "node --experimental-strip-types --test src/lib/chat/voice-state.test.ts",
    "test:connectors": "node --experimental-strip-types --test src/lib/agents/vendor-rows.test.ts src/lib/agents/check-runs.test.ts src/lib/agents/mcp-connectors.test.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@agentdeck/protocol-ts": "workspace:*",
    "@agentdeck/ui": "workspace:*",
    "@aiden0z/pptx-renderer": "^1.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/google-sans": "^5.3.2",
    "@phosphor-icons/core": "2.1.1",
    "@shival99/z-ui-svelte": "0.1.19",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/svelte": "1.7.0",
    "boneyard-js": "^1.10.0",
    "docx-preview": "^0.4.1",
    "dompurify": "3.4.17",
    "marked": "17.0.6",
    "prettier": "3.9.10",
    "shiki": "4.5.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "0.25.12",
    "html-to-image": "^1.11.13",
    "ng2-pdfjs-viewer": "^26.5.0",
    "svelte": "^5.40.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.0"
  }
